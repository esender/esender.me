---
const { title, start_date, end_date, position, stack, description, points, isFirst } =
  Astro.props;

const startYear = start_date.getFullYear();
const endYear = end_date ? end_date.getFullYear() : "Present";
const dateRange = `${startYear} — ${endYear}`;
---

<article
  class:list={[
    "group grid grid-cols-1 md:grid-cols-12 gap-8 items-start",
    !isFirst && "border-t border-outline-variant/20 pt-24",
  ]}
>
  <!-- Left column: dates & position -->
  <div class="md:col-span-3 pt-2">
    <div class="label-sm text-tertiary mb-1">{dateRange}</div>
    <div class="label-sm text-primary font-bold">{position}</div>
  </div>

  <!-- Right column: company, description, stack -->
  <div class="md:col-span-9">
    <h3 class="font-bold text-2xl mb-6 group-hover:text-primary transition-colors">
      {title}
    </h3>
    {
      description?.map((paragraph: string) => (
        <p class="text-on-surface-variant leading-relaxed text-lg max-w-2xl mb-4">
          {paragraph}
        </p>
      ))
    }
    {
      points && (
        <ul class="text-on-surface-variant text-lg max-w-2xl mb-4 list-disc list-inside">
          {points?.map((point: string) => (
            <li>{point}</li>
          ))}
        </ul>
      )
    }
    <div class="flex flex-wrap gap-6 mt-8">
      {stack.map((tech: string) => (
        <span class="label-sm text-outline">• {tech}</span>
      ))}
    </div>
  </div>
</article>
