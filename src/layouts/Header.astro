---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 glass">
  <div class="max-w-7xl mx-auto px-5 sm:px-12 py-4 flex justify-between items-center">
    <a
      href="/"
      class:list={[
        "text-2xl font-extrabold tracking-tighter no-underline",
        "no-animation",
        "text-warm-900",
        "transition-colors duration-200",
        "hover:text-accent",
      ]}
    >
      esender.me
    </a>
    <Navigation />
  </div>
</header>
