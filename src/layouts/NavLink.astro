---
const { href } = Astro.props;
const isActive =
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "no-animation relative transition-colors duration-200 text-sm",
    {
      "no-underline text-primary font-medium": isActive,
      "no-underline text-on-surface-variant hover:text-on-surface font-normal": !isActive,
    },
  ]}
>
  <slot />
</a>
