---
const { href } = Astro.props;
const isActive =
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<a
  href={href}
  class:list={[
    "no-animation relative transition-colors duration-200 text-sm",
    {
      "no-underline text-accent border-b border-accent pb-1 font-medium": isActive,
      "no-underline text-warm-500 hover:text-warm-800 font-normal": !isActive,
    },
  ]}
>
  <slot />
</a>
