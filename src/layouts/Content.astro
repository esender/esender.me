---
interface Props {
  class?: string;
  as?: "div" | "article" | "section";
}

const { class: className, as: Wrapper = "div" } = Astro.props;
---

<Wrapper class:list={["max-w-7xl mx-auto px-5 sm:px-12 lg:w-10/12 pt-section lg:pt-section-lg pb-section lg:pb-section-lg", className]}>
  <slot />
</Wrapper>
