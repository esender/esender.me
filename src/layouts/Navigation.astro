---
import { getCollection } from "astro:content";
import NavLink from "@layouts/NavLink.astro";
import { isVisiblePost } from "@utils/date";

const posts = await getCollection("posts", isVisiblePost);
---

<nav class:list={["flex gap-4 font-sans font-medium tracking-tight", "sm:gap-6", "md:gap-10"]}>
  <NavLink href="/">Home</NavLink>
  {!!posts.length && <NavLink href="/posts/">Blog</NavLink>}
  <NavLink href="/about/">About</NavLink>
</nav>
