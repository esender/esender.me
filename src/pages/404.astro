---
import MicroLabel from "@components/MicroLabel.astro";
import Content from "@layouts/Content.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page not found">
  <Content class="md:mt-4 text-center py-16">
    <MicroLabel>404</MicroLabel>
    <h2 class="mb-4">This page wandered off</h2>
    <p class="text-on-surface-variant mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="no-animation ghost-border rounded-full px-5 py-2 text-sm font-mono text-on-surface-variant hover:text-on-surface transition-colors duration-200 no-underline">
      Head back home
    </a>
  </Content>
</Layout>
